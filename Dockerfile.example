# @Antigravity, 20261120, [INIT]: 新增多阶段构建 Dockerfile 示例

# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    INFO_CENTER_HOST=0.0.0.0 \
    INFO_CENTER_PORT=3200 \
    INFO_CENTER_PATROL_INTERVAL_MS=60000 \
    INFO_CENTER_HEARTBEAT_TIMEOUT_MS=259200000

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

USER node
EXPOSE 3200

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.INFO_CENTER_PORT || 3200) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "dist/main.js"]
